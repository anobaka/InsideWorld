<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Everything the thin client needs *because its server is on another machine*:
      forwarding, request signing, pairing, discovery, path mapping, and the handlers
      that run a command on the machine the user is sitting at.

      "Remoting", not "Client", is the boundary. Being a client — a window, a tray icon,
      an embedded browser, a media player — is something both flavours do, and all of it
      lives in Bakabase.Shell and the modules. What lives here is only what stops making
      sense the moment the server is in-process: every piece of it would be a no-op or an
      identity mapping in the all-in-one, which is why that flavour does not reference
      this project and its container holds none of these types.

      Deliberately free of Avalonia and of Bakabase.Service. The shell talks to a host
      through IShellHost, and this project is what the client flavour puts behind it, so
      keeping both out is what lets the two flavours share one shell without either
      dragging the other's world along.
    -->
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!--
          Matches the project name, and deliberately differs from the entry project's
          Bakabase.Client: two assemblies cannot share a name, and that one is pinned by
          the shipped executable.
        -->
        <AssemblyName>Bakabase.Client.Remoting</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\libs\Bakabase.Infrastructures\Bakabase.Infrastructures\Bakabase.Infrastructures.csproj" />
        <ProjectReference Include="..\..\modules\Bakabase.Modules.Player\Bakabase.Modules.Player.csproj" />
        <ProjectReference Include="..\..\modules\Bakabase.Modules.RemoteAccess\Bakabase.Modules.RemoteAccess.csproj" />
        <!-- For the cookie-capture flows and the orchestration that drives them: the
             sign-in window has to open on the machine the user is sitting at. -->
        <ProjectReference Include="..\..\modules\Bakabase.Modules.ThirdParty\Bakabase.Modules.ThirdParty.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
      <!--
        Errors from this process. Not Sentry.AspNetCore: its diagnostic listener files an
        event per failed HTTP request, and every request this process handles is a relay
        to a server on somebody's LAN.
      -->
      <PackageReference Include="Sentry.Extensions.Logging" Version="4.13.0" />
    </ItemGroup>

    <ItemGroup>
        <!--
          Flows into the entry project's output, where ClientHost adds it to the
          configuration by name. Deliberately not called appsettings.json: the test project
          references both this and Bakabase.Service, and two files with that name silently
          overwrite one another in the output — whichever copies last wins, and nothing
          warns.
        -->
        <Content Include="client-analytics.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- The connect page. Embedded so it cannot go missing from an install, and so
             nothing on disk can be swapped for a page that would run at this client's
             own origin with its /client API in reach. -->
        <EmbeddedResource Include="Assets\connect.html" />
    </ItemGroup>

</Project>
