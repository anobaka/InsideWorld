{
  // The client's error reporting. Its own file because this flavour ships without the
  // server, and therefore without the server's appsettings.json.
  //
  // The DSN value is deliberately the one Bakabase.Service uses: both flavours run almost
  // entirely the same code, and an error worth looking at in one is usually worth looking
  // at in the other. Events are told apart by the launch_mode tag rather than by project.
  // ClientTelemetryTests asserts the two files carry the same value, so this copy cannot
  // drift.
  //
  // The key is ClientDsn rather than the server's BackendDsn on purpose. Both files land
  // in the test project's output directory, and a shared key would have every test host
  // built from ClientStartup start reporting into the live project.
  //
  // Overridable per install with Analytics__Sentry__ClientDsn, and an empty value turns
  // reporting off entirely.
  "Analytics": {
    "Sentry": {
      "ClientDsn": "https://f9b19f6c5f553c70ce834f5190ce8cb4@o4511358982684672.ingest.us.sentry.io/4511359005229056"
    }
  }
}
