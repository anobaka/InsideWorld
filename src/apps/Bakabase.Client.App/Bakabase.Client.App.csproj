<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The thin client's entry point. Everything visual lives in Bakabase.Shell; what
      remains here is the process entry, the packaging inputs, and the one thing that
      makes this flavour the client — the reference to Bakabase.Client, wrapped as an
      IShellHost. Its all-in-one twin is Bakabase/Bakabase.csproj; the two differ only
      in which host they put behind the same shell.
    -->
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ApplicationIcon>..\Bakabase.Shell\Assets\favicon.ico</ApplicationIcon>
        <AssemblyName>Bakabase.Client</AssemblyName>
        <RootNamespace>Bakabase.Client.App</RootNamespace>
        <ApplicationManifest>..\Bakabase\app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.3.20" />
        <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
        <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3856.49" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
        <PackageReference Include="Velopack" Version="0.0.1298" />
        <PackageReference Include="Nerdbank.GitVersioning" Version="3.7.115">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bakabase.Shell\Bakabase.Shell.csproj" />
        <ProjectReference Include="..\Bakabase.Client\Bakabase.Client.csproj" />
    </ItemGroup>

    <!-- Copy favicon.png to output for macOS Dock icon -->
    <ItemGroup>
        <None Include="..\Bakabase.Shell\Assets\dock-icon.png" CopyToOutputDirectory="PreserveNewest" Link="Assets\dock-icon.png" />
    </ItemGroup>

    <!-- Windows icon for Velopack packaging -->
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <None Include="..\Bakabase.Shell\Assets\favicon.ico" CopyToOutputDirectory="PreserveNewest" Link="Assets\favicon.ico" />
    </ItemGroup>

    <!-- macOS app bundle configuration -->
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <Content Include="Info.plist" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\Bakabase.Shell\Assets\app.icns" CopyToOutputDirectory="PreserveNewest" Link="Assets\app.icns" />
    </ItemGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <OutputType>Exe</OutputType>
    </PropertyGroup>

</Project>
